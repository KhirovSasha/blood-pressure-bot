# Copy this file to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
# The .env file is git-ignored (see .gitignore)

# Token issued by @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram IDs allowed to use the bot, comma-separated, no spaces.
# Messages from anyone else are silently ignored.
ADMINS=111111111,222222222

# Telegram ID of the patient the readings belong to.
# This value is what gets written to pressure_data.user_id,
# regardless of which operator from ADMINS submitted the entry.
PATIENT_ID=111111111

# Recipient for reminders. NOT used in code yet —
# reserved for a future reminders feature.
REMAIND_ID=111111111

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pressure_monitor
DB_USER=postgres
DB_PASSWORD=changeme
